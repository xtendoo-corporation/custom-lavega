<odoo>

    <record id="account_invoices_copy" model="ir.actions.report">
        <field name="name">Facturas con Copia</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lavega_document_format.report_invoice_copy</field>
        <field name="report_file">lavega_document_format.report_invoice_copy</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_invoice_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-set="is_copy" t-value="0"/>
                <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                   t-call="account.report_invoice_document"
                   t-lang="lang"/>

                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-set="is_copy" t-value="1"/>
                <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                   t-call="account.report_invoice_document"
                   t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='due_date']" position="replace"/>
        <xpath expr="//div[@name='delivery_date']" position="replace"/>
        <xpath expr="//div[@name='origin']" position="replace"/>

        <!-- Reemplazar la primera fila que contiene la dirección del cliente -->
        <xpath expr="//div[@class='row'][1]" position="replace">
            <div class="row mb-4" style="margin-bottom: 2rem !important;">
                <!-- Columna izquierda: Título de la factura y fecha -->
                <div class="col-6 text-start">
                    <h2 class="mt-0 mb-2" style="margin-top: 0 !important;">
                        <t t-if="o.move_type == 'out_invoice' and o.state == 'draft'">PROFORMA Factura</t>
                        <t t-elif="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</t>
                        <t t-elif="o.move_type == 'out_refund'">Nota de Crédito</t>
                        <t t-else=""><t t-esc="o.move_type"/></t>
                        <span t-if="o.name and o.name != '/'" t-field="o.name"/>
                    </h2>
                    <div class="mb-2">
                        <strong>Fecha:</strong> <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                    </div>
                </div>
                <!-- Columna derecha: Datos del cliente -->
                <div class="col-6 text-end" name="customer_address">
                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">NIF</t>: <span t-field="o.partner_id.vat"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Ocultar el título original de la factura -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title"/>
        </xpath>

        <!-- Eliminar la sección #informations ya que la fecha ahora está arriba -->
        <xpath expr="//div[@id='informations']" position="replace"/>

        <xpath expr="//div[@name='comment']" position="after">
            <t t-if="is_copy == 1">
                <div class="row" t-if="report_type == 'pdf'"
                     style="position:absolute; top:0; right:0; width:100%; text-align:right; padding-right:10px; padding-top:10px;">
                    <div class="col-12" name="watermark">
                        <span style="color:gray; font-size:6em; position:absolute; top:0; right:10px; opacity:0.2;">
                            ES COPIA
                        </span>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//p[@name='payment_communication']" position="replace"/>
    </template>

</odoo>
