<odoo>
    <record id="view_product_sync_wizard" model="ir.ui.view">
        <field name="name">product.sync.wizard.form</field>
        <field name="model">product.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sincronizar productos">
                <group>
                    <field name="company_src_id"/>
                    <field name="company_dst_id"/>
                </group>
                <footer>
                    <button string="Sincronizar" type="object" name="action_sync_products" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sincronizar productos entre compañías</field>
        <field name="res_model">product.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_product_sync_wizard"
              name="Sincronizar productos"
              parent="base.menu_administration"
              action="action_product_sync_wizard"
              sequence="100"/>
</odoo>

